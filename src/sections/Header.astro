---
import Document from "../icons/document.astro";
import Github from "../icons/github.astro";
import Gmail from "../icons/gmail.astro";
import Linkedin from "../icons/linkedin.astro";
import Upwork from "../icons/upwork.astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;

  gmailLink: string;
  githubLink: string;
  linkedinLink: string;
  resumeLink: string;
  twitterLink: string;
  upworkLink: string;
}

const {
  title,
  subtitle,
  description,

  gmailLink,
  githubLink,
  linkedinLink,
  resumeLink,
  twitterLink,
  upworkLink,
} = Astro.props;

// Each in-page section carries its own accent hue, surfaced only in the
// nav dash + label on hover/active. Colorful rhythm, minimal footprint.
const navItems = [
  { label: "About", accent: "var(--accent-about)" },
  { label: "Experience", accent: "var(--accent-experience)" },
  { label: "Projects", accent: "var(--accent-projects)" },
];
---

<script>
  import { scrambleAndReveal } from "../utils";

  document.querySelectorAll(".social-link").forEach((link) => {
    link.addEventListener("click", (e: any) => {
      const type = e.target.getAttribute("data-type");
      window.posthog.capture(`$${type}_click`);
      window.posthog.capture(`$social_link_click`);
    });
  });

  window.addEventListener("load", () => {
    const nameRef = document.getElementById("title");
    scrambleAndReveal(nameRef as HTMLElement);
  });
</script>

<section
  class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-1/2 lg:flex-col lg:justify-between pt-32 pb-20 md:py-24"
>
  <div class="w-full header">
    <h1
      id="title"
      class="heading w-fit text-4xl font-bold tracking-tight text-balance bg-gradient-to-r from-scooter-300 via-blue-400 to-violet-400 bg-clip-text text-transparent print:bg-none print:text-black sm:text-5xl"
    >
      {title}
    </h1>
    <h3
      class="subheading mt-3 md:mt-4 font-semibold text-neutral-300 print:text-black text-sm sm:text-lg"
    >
      {subtitle}
    </h3>

    <p
      class="description mt-4 max-w-xs leading-normal text-neutral-400 print:text-black text-pretty text-[15px]"
    >
      {description}
    </p>

    <div
      class="mt-5 inline-flex items-center gap-2 rounded-full border border-neutral-700/60 bg-neutral-800/30 px-3 py-1 text-xs font-medium text-neutral-300 print:hidden"
    >
      <span class="status-dot h-2 w-2 rounded-full bg-mantis-400"></span>
      Available for work
    </div>

    <nav class="nav hidden lg:block" aria-label="In-page jump links">
      <ul class="mt-20 w-max">
        {
          navItems.map((item) => (
            <li class="nav-item">
              <a
                class="group flex items-center py-3"
                style={`--nav-accent:${item.accent}`}
                aria-label={`Jump to ${item.label} section`}
                href={"#" + item.label.toLowerCase()}
              >
                <span class="nav-indicator mr-4 h-px w-8 bg-neutral-600 transition-all group-hover:w-16 group-hover:bg-[var(--nav-accent)] group-focus-visible:w-16 group-focus-visible:bg-[var(--nav-accent)] motion-reduce:transition-none" />
                <span class="nav-text text-xs font-bold uppercase tracking-widest text-neutral-400/80 transition-colors group-hover:text-[var(--nav-accent)] group-focus-visible:text-[var(--nav-accent)] motion-reduce:transition-none">
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="flex items-center gap-5 mt-8 [&>*]:p-1">
    <a
      target="_blank"
      class="social-link pressable"
      rel="noreferrer"
      aria-label="send a mail to devang"
      title="send a mail to devang"
      href={gmailLink}
      data-type="gmail"
    >
      <Gmail />
    </a>
    <a
      target="_blank"
      class="social-link pressable"
      rel="noreferrer"
      aria-label="linkedin profile url"
      title="linkedin profile url"
      href={linkedinLink}
      data-type="linkedin"
    >
      <Linkedin />
    </a>
    <a
      target="_blank"
      class="social-link pressable"
      rel="noreferrer"
      aria-label="github of devang"
      title="github of devang"
      href={githubLink}
      data-type="github"
    >
      <Github />
    </a>
    <a
      target="_blank"
      class="social-link pressable"
      rel="noreferrer"
      aria-label="upwork profile of devang"
      title="upwork profile of devang"
      href={upworkLink}
      data-type="upwork"
    >
      <Upwork />
    </a>
    <a
      target="_blank"
      class="social-link pressable -ml-1"
      rel="noreferrer"
      aria-label="resume of devang"
      title="resume of devang"
      href={resumeLink}
      data-type="resume"
    >
      <Document />
    </a>
  </div>
</section>
