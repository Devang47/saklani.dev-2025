---
import Posthog from "../components/Posthog.astro";
import "../css/global.scss";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const defaultTitle = "Devang Saklani | Software Engineer";
const defaultDescription =
  "Devang Saklani is an experienced software engineer who specializes in building (and occasionally designing) exceptional digital experiences and web apps.";

const {
  title = defaultTitle,
  description = defaultDescription,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://saklani.dev");
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL("/og.png", siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Devang Saklani",
  url: siteUrl.href,
  jobTitle: "Software Engineer",
  sameAs: [
    "https://github.com/Devang47",
    "https://twitter.com/devangsaklani",
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@devangsaklani" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link
      rel="preload"
      href="/sohne.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />

    <Posthog />
  </head>

  <body class="leading-relaxed antialiased selection:bg-white/10">
    <slot />
  </body>
</html>
