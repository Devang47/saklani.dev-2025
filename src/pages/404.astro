---
import Layout from "../layouts/Layout.astro";
import Game from "../sections/Game/Game.astro";
---

<Layout
  title="Page not found | Devang Saklani"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <div
    class="text-white h-screen w-full flex items-center justify-center flex-col gap-10"
  >
    <div class="">
      <p
        class="text-center text-7xl md:text-8xl font-bold tracking-tight bg-gradient-to-r from-scooter-300 via-blue-400 to-violet-400 bg-clip-text text-transparent"
      >
        404
      </p>
      <h1 class="font-medium text-3xl md:text-5xl text-center mt-2">
        Page <span class="line-through decoration-pink-400 decoration-2"
          >not</span
        > found
      </h1>
      <p class="text-center block mt-6 text-neutral-400">
        You seem to be lost. <a
          href="/"
          class="text-neutral-200 underline decoration-scooter-400/50 underline-offset-4 transition-colors hover:text-scooter-300 hover:decoration-scooter-300 motion-reduce:transition-none"
          >Go back home</a
        >.
      </p>
      <p class="text-center block mt-2 text-xs text-neutral-500">
        Or beat the bot at tic-tac-toe while you're here. 👇
      </p>
    </div>

    <Game />
  </div>
</Layout>
