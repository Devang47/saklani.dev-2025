---
import Layout from "../layouts/Layout.astro";
import Game from "../sections/Game/Game.astro";
---

<script>
  import { animate } from "motion";

  animate("body", {
    opacity: 1,
  });
</script>

<Layout>
  <div
    class="text-white h-screen w-full flex items-center justify-center flex-col gap-10"
  >
    <div class="">
      <h1 class="font-medium text-4xl md:text-6xl text-center">
        Page <span class="line-through">not</span> found
      </h1>
      <p class="text-center block mt-6">
        You seem to be lost. <a href="/" class="underline underline-offset-2"
          >Go back home</a
        >.
      </p>
    </div>

    <Game />
  </div>
</Layout>
